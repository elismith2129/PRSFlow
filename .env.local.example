NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# REQUIRED FOR LOCAL DEV LOGIN: the PIN login route (/api/auth/pin) mints sessions
# with the service-role key. Without it, localhost boots but you cannot log in.
# Get it from Supabase dashboard -> Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional locally — needed only for the features that use them:
# ANTHROPIC_API_KEY=            # /api/ocr-receipt (receipt OCR)
# RESEND_API_KEY=               # email — campaigns AND the new-inquiry alert
# MAIL_FROM=                    # optional; defaults to the verified info@ sender
# INQUIRY_ALERT_TO=             # optional; defaults to info@paramountrecording.com
# CRON_SECRET=                  # cron endpoints auth

# Base URL for links sent to clients (e.g. registration links).
# Set to your Vercel production URL in production; leave unset in local dev.
# NEXT_PUBLIC_BASE_URL=https://prs-flow.vercel.app
